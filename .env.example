# Copy to .env and fill in. Real environment variables override this file,
# and CLI flags override both.

# ── Secrets ────────────────────────────────────────────────────────────────
# Spotify developer app (https://developer.spotify.com/dashboard). Required.
# Can be overridden per run with --spotify-client-id / --spotify-client-secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional. Must match the redirect URI in the dashboard exactly.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Optional. Default: <MIXMANSION_WORKSPACE>/spotify_token_<client_id>.json
# SPOTIFY_TOKEN_CACHE=

# LLM for mood tagging and playlist names, and an embeddings model for mood
# similarity. Provider and model are required once a connector uses them; the
# rest is optional. Any LiteLLM provider works (ollama, openai, anthropic,
# openrouter, openai_compatible for LM Studio / vLLM, ...).
# Local (Ollama):
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:14b
LLM_URL=http://localhost:11434
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_URL=http://localhost:11434
# Cloud example:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5
# LLM_API_KEY=...
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_API_KEY=...
# Optional tuning:
# LLM_TEMPERATURE=
# LLM_TIMEOUT=120
# LLM_MAX_CONCURRENCY=4
# Last.fm API key for genre tags (required by the genre categorizer).
# Create one at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# ── App ────────────────────────────────────────────────────────────────────
# All optional; the values shown are the defaults.
# Local state directory (caches, pools, tokens).
# MIXMANSION_WORKSPACE=.mixmansion
# Active adapters.
# MIXMANSION_POOL_STORE=file_kv
# MIXMANSION_PLAN_STORE=yaml_file
# MIXMANSION_WRITER=spotify
# MIXMANSION_GROUPER=louvain
# MIXMANSION_NAMER=llm
# Default categorizers and their weights (JSON).
# MIXMANSION_WEIGHTS={"genre": 0.5, "mood": 0.5}
# MIXMANSION_LOG_LEVEL=INFO

# ── Connector defaults ─────────────────────────────────────────────────────
# Adapter params follow MIXMANSION_<PORT>_<ADAPTER>_<FIELD>, e.g.
# MIXMANSION_RETRIEVER_SEARCH_LIMIT=20
# Each connector adds its keys below.
# Default: <MIXMANSION_WORKSPACE>/pools
# MIXMANSION_POOL_STORE_FILE_KV_DIR=

# Path used when `plan`/`apply` are run without an explicit file argument.
# MIXMANSION_PLAN_STORE_YAML_FILE_DEFAULT_PATH=plan.yaml

# Max number of search results for the `search` retriever (default 20).
# MIXMANSION_RETRIEVER_SEARCH_LIMIT=20
# Create public instead of private playlists.
# MIXMANSION_WRITER_SPOTIFY_PUBLIC=false
# Prefix for generated playlist names, e.g. "◐ ".
# MIXMANSION_WRITER_SPOTIFY_NAME_PREFIX=

# llm namer. Uses the LLM_* settings above.
# MIXMANSION_NAMER_LLM_SAMPLE_SIZE=15
# MIXMANSION_NAMER_LLM_TOP_TAGS=10
# MIXMANSION_NAMER_LLM_MAX_NAME_LENGTH=40
# MIXMANSION_NAMER_LLM_LANGUAGE=en
# MIXMANSION_NAMER_LLM_STYLE=

# Mood categorizer (optional; defaults shown). Uses the LLM_* and EMBEDDINGS_* settings.
# Songs per LLM request; smaller batches are easier for small local models.
# MIXMANSION_CATEGORIZER_MOOD_BATCH_SIZE=10
# MIXMANSION_CATEGORIZER_MOOD_TAGS_PER_SONG=8
# Characters of lyrics sent to the LLM per song.
# MIXMANSION_CATEGORIZER_MOOD_LYRICS_MAX_CHARS=1500

# Genre categorizer (optional; defaults shown).
# How much Spotify artist genres and Last.fm tags count.
# MIXMANSION_CATEGORIZER_GENRE_SPOTIFY_WEIGHT=1.0
# MIXMANSION_CATEGORIZER_GENRE_LASTFM_WEIGHT=1.0
# Ignore Last.fm tags with a count (0-100) below this.
# MIXMANSION_CATEGORIZER_GENRE_LASTFM_MIN_COUNT=10
# MIXMANSION_CATEGORIZER_GENRE_LABELS_PER_SONG=5

# Louvain grouper (optional; defaults shown)
# Neighbours kept per song in the fused similarity graph that Louvain partitions.
# MIXMANSION_GROUPER_LOUVAIN_K=15
# Higher resolution means more, smaller playlists.
# MIXMANSION_GROUPER_LOUVAIN_RESOLUTION=1.0
# Communities smaller than this are merged into their closest neighbour.
# MIXMANSION_GROUPER_LOUVAIN_MIN_SIZE=15
# A song also joins a second playlist if it fits within this fraction of its best fit.
# MIXMANSION_GROUPER_LOUVAIN_TAU=0.05
# MIXMANSION_GROUPER_LOUVAIN_MAX_MEMBERSHIPS=2
# MIXMANSION_GROUPER_LOUVAIN_SEED=42
