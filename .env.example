# Copy to .env and fill in. Real environment variables override this file,
# and CLI flags override both.

# ── Secrets ────────────────────────────────────────────────────────────────
# Spotify developer app (https://developer.spotify.com/dashboard). Required.
# Can be overridden per run with --spotify-client-id / --spotify-client-secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional. Must match the redirect URI in the dashboard exactly.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Optional. Default: <MIXMANSION_WORKSPACE>/spotify_token_<client_id>.json
# SPOTIFY_TOKEN_CACHE=

# ── App ────────────────────────────────────────────────────────────────────
# All optional; the values shown are the defaults.
# Local state directory (caches, pools, tokens).
# MIXMANSION_WORKSPACE=.mixmansion
# Active adapters.
# MIXMANSION_POOL_STORE=file_kv
# MIXMANSION_PLAN_STORE=yaml_file
# MIXMANSION_WRITER=spotify
# MIXMANSION_GROUPER=louvain
# MIXMANSION_NAMER=llm
# Default categorizers and their weights (JSON).
# MIXMANSION_WEIGHTS={"genre": 0.5, "mood": 0.5}
# MIXMANSION_LOG_LEVEL=INFO

# ── Connector defaults ─────────────────────────────────────────────────────
# Adapter params follow MIXMANSION_<PORT>_<ADAPTER>_<FIELD>, e.g.
# MIXMANSION_RETRIEVER_SEARCH_LIMIT=20
# Each connector adds its keys below.
# Default: <MIXMANSION_WORKSPACE>/pools
# MIXMANSION_POOL_STORE_FILE_KV_DIR=
